rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Organizations (Step 1 basic info). Only the owning admin can read/write
    // directly; the server also writes here via the Admin SDK, which bypasses
    // these rules entirely.
    match /organizations/{orgId} {
      allow read, write: if request.auth != null && request.auth.uid == orgId;
    }

    // Published articles (Step 3/4) are publicly readable so anyone can view
    // the recruitment page. All writes go through server.ts using the Admin
    // SDK (publish / approve-proposal endpoints), so client writes are denied
    // here to keep article content trustworthy.
    match /articles/{articleId} {
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }

    // Analytics events (Step 5), improvement proposals (Step 6/7), and the
    // Trigger Email extension's outbox are all written/read exclusively by
    // server.ts via the Admin SDK, which is not subject to these rules.
    // No direct client access.
    match /analyticsEvents/{eventId} {
      allow read, write: if false;
    }
    match /improvementProposals/{proposalId} {
      allow read, write: if false;
    }
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
