# --- Server-side (never exposed to the browser) ---
# Gemini API key used by server.ts to call the free-tier Gemini API for
# interviews, article generation, SNS copy, and improvement proposals.
GEMINI_API_KEY=

# Firebase Admin SDK service account (used by server.ts for Firestore writes
# such as analytics events, publishing articles, and improvement proposals).
# Path to a downloaded service-account JSON, OR set the three fields below.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
FIREBASE_PROJECT_ID=

# --- Client-side (safe to expose; injected via Vite define in src/lib/firebase.ts) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public base URL used to build published article / SNS share links.
APP_URL=http://localhost:3000
